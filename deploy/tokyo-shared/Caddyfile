shop.zynexus.top {
    encode zstd gzip
    reverse_proxy shop:8080
}

api.zynexus.top {
    encode zstd gzip
    reverse_proxy sub2api:8080 {
        header_up -CF-Connecting-IP
        header_up -X-Real-IP
        header_up X-Forwarded-For {remote_host}
    }
}

zynexus.top {
    encode zstd gzip
    root * /srv/portal
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
